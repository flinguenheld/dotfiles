#!/usr/bin/env bash
# florent@linguenheld.fr 2026

PALETTE_FILE="$HOME/.config/theme/palette.toml"

WAYBAR_FOLDER="$HOME/.config/waybar"
WAYBAR_PALETTE_FILE="$WAYBAR_FOLDER/palette.css"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
{
  echo "/* Generated by theme_apply from palette.toml (${theme}), do not edit */"
  echo
  echo "/* Blocks, left to right */"
  echo "@define-color hardware   ${c2};"
  echo "@define-color workspaces ${c0};"
  echo "@define-color time       ${c1};"
  echo "@define-color sound      ${c3};"
  echo "@define-color bluetooth  ${c4};"
  echo "@define-color web        ${c5};"
  echo "@define-color commands   ${c6};"
  echo
  echo "/* Laptop: next to their neighbours (hardware, sound) */"
  echo "@define-color battery    ${c2};"
  echo "@define-color backlight  ${c3};"
  echo
  echo "/* Fixed */"
  echo "@define-color background       ${background};"
  echo "@define-color foreground       ${foreground};"
  echo "@define-color text             ${background};"
  echo "@define-color red              ${alert};"
  echo "@define-color workspace_urgent ${alert};"
  echo "@define-color disabled         ${muted};"
  echo "@define-color disabled-dark    ${surface};"
  echo "@define-color disabled-speaker ${surface};"
} > "${WAYBAR_PALETTE_FILE}" || exit 1

# No reload here: theme_menu runs niri/scripts/startup afterwards, which
# restarts waybar. When running this adapter alone, reload by hand:
# SIGUSR2 makes waybar reload its config and style
# pkill -SIGUSR2 waybar
