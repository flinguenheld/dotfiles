{
  "bluetooth": {
    //"controller": "controller1",
    //"format-device-preference": "",
    "format": "  {status} ",
    "format-on": " 󰂰 {status} ",
    "format-off": " 󰂲 {status} ",
    "format-disabled": " 󰂲 {status} ",
    "format-connected": " 󰂰 {device_alias} ",
    "format-connected-battery": "󰥂 {device_alias}, {device_battery_percentage}%",
    "tooltip": true,
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "overskride"
    // "on-click-right": "blueman-manager"
  },
  "clock#date": {
    "interval": 60,
    "align": 0,
    "rotate": 0,
    "timezone": "Europe/Paris",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small><span alpha='40%'>────────────────────────────────────────────────────────────────────────</span>\n{calendar}</small></tt>",
    "format": "󰥔  {:%a %b %d, %Y}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<span alpha='45%'>W{}</span>",
        "weekdays": "<span alpha='70%'><b>{}</b></span>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "clock#time": {
    "interval": 1,
    "align": 0,
    "rotate": 0,
    "timezone": "Europe/Paris",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><span alpha='40%'>────────────────────────</span>\n{calendar}</tt>",
    // "format": "󰥔  {:%I:%M %p}",
    "format": " {:%H:%M} ",
    "format-alt": " {:%H:%M:%S} ",
    // "format-alt": "󱑑  {:%I:%M:%S %p}",
    // "format-alt": " {:%a %b %d, %G}"
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<span alpha='45%'>W{}</span>",
        "weekdays": "<span alpha='70%'><b>{}</b></span>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/themes": {
    "format": "󰏘",
    "tooltip": false,
    "on-click": "$HOME/.config/theme/theme_menu"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "$HOME/.config/niri/scripts/power_menu"
  },
  "cpu": {
    "interval": 5,
    "format": "  {usage}%"
  },
  "memory": {
    "interval": 5,
    "format": "  {percentage}%"
  },
  "network": {
    "interval": 5,
    "format-wifi": "  {essid}",
    "format-alt": "󰖟  {ipaddr}/{cidr}",
    "format-ethernet": "  {bandwidthUpBits} |  {bandwidthDownBits}",
    "format-linked": " {ifname} (No IP)",
    "format-disconnected": "󰌙 Disconnected",
    "format-disabled": " Disabled",
    // "format-alt": " {bandwidthUpBits} |  {bandwidthDownBits}",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "on-click-right": "wezterm start -- nmtui"
  },
  "custom/expressvpn": {
    "interval": 5,
    "exec": "~/.config/niri/scripts/expressvpn",
    "on-click": "expressvpn connect",
    "on-click-right": "expressvpn disconnect"
  },
  "pulseaudio#speaker": {
    "format": "{icon} {volume}%",
    "format-muted": "  Mute",
    "format-bluetooth": " {volume}% {format_source}",
    "format-bluetooth-muted": " Mute",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      // "headphone": "",
      // "hands-free": "",
      // "headset": "",
      // "phone": "",
      // "portable": "",
      // "car": "",
      "default": [
        "",
        "",
        " "
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+"
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "  Mute",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SOURCE@ 5%-",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SOURCE@ 5%+"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "timeout": 30
  },
  "niri/workspaces": {
    "format": "{value}"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  // ─────────────────────────────────────────────────────────── LAPTOP ─────
  // Not in the bar on the desktop (no battery, no backlight).
  // On a laptop: add "battery" to group/hardware and "backlight" to
  // modules-right in config.
  "battery": {
    "interval": 60,
    "align": 0,
    "rotate": 0,
    //"bat": "BAT1",
    //"adapter": "ACAD",
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "{icon} Full",
    //"format-good": "",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-time": "{H}h {M}min",
    "tooltip": true
  },
  "backlight": {
    "interval": 2,
    "align": 0,
    "rotate": 0,
    //"device": "amdgpu_bl0",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      ""
    ],
    "on-click": "",
    "on-click-middle": "",
    "on-click-right": "",
    "on-update": "",
    "on-scroll-up": "light -A 5%",
    "on-scroll-down": "light -U 5%",
    "smooth-scrolling-threshold": 1
  }
}
