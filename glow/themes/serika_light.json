{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#323437",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#646669",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#3f5673",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#d1d0c5",
    "background_color": "#5a4066",
    "bold": true
  },
  "h2": {
    "color": "#3f5673",
    "prefix": "## "
  },
  "h3": {
    "color": "#455054",
    "prefix": "### "
  },
  "h4": {
    "color": "#3d5128",
    "prefix": "#### "
  },
  "h5": {
    "color": "#9a7d0e",
    "prefix": "##### "
  },
  "h6": {
    "color": "#646669",
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#9a7d0e",
    "italic": true
  },
  "strong": {
    "color": "#791717",
    "bold": true
  },
  "hr": {
    "color": "#646669",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#455054",
    "underline": true
  },
  "link_text": {
    "color": "#3f5673",
    "bold": true
  },
  "image": {
    "color": "#5a4066",
    "underline": true
  },
  "image_text": {
    "color": "#646669",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#791717",
    "background_color": "#c4c3b7"
  },
  "code_block": {
    "color": "#323437",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#323437"
      },
      "error": {
        "color": "#d1d0c5",
        "background_color": "#da3333"
      },
      "comment": {
        "color": "#646669",
        "italic": true
      },
      "comment_preproc": {
        "color": "#9a7d0e"
      },
      "keyword": {
        "color": "#5a4066"
      },
      "keyword_reserved": {
        "color": "#5a4066"
      },
      "keyword_namespace": {
        "color": "#791717"
      },
      "keyword_type": {
        "color": "#9a7d0e"
      },
      "operator": {
        "color": "#455054"
      },
      "punctuation": {
        "color": "#323437"
      },
      "name": {
        "color": "#323437"
      },
      "name_builtin": {
        "color": "#791717"
      },
      "name_tag": {
        "color": "#3f5673"
      },
      "name_attribute": {
        "color": "#9a7d0e"
      },
      "name_class": {
        "color": "#9a7d0e",
        "bold": true
      },
      "name_constant": {
        "color": "#9a7d0e"
      },
      "name_decorator": {
        "color": "#455054"
      },
      "name_exception": {
        "color": "#791717"
      },
      "name_function": {
        "color": "#3f5673"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#9a7d0e"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#3d5128"
      },
      "literal_string_escape": {
        "color": "#455054"
      },
      "generic_deleted": {
        "color": "#791717"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#3d5128"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#646669"
      },
      "background": {
        "background_color": "#c4c3b7"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
