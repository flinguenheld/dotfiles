{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#5c6a72",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#a4a9a5",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#3a94c5",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#fdf6e3",
    "background_color": "#df69ba",
    "bold": true
  },
  "h2": {
    "color": "#3a94c5",
    "prefix": "## "
  },
  "h3": {
    "color": "#35a77c",
    "prefix": "### "
  },
  "h4": {
    "color": "#8da101",
    "prefix": "#### "
  },
  "h5": {
    "color": "#dfa000",
    "prefix": "##### "
  },
  "h6": {
    "color": "#a4a9a5",
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#dfa000",
    "italic": true
  },
  "strong": {
    "color": "#f85552",
    "bold": true
  },
  "hr": {
    "color": "#a4a9a5",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#35a77c",
    "underline": true
  },
  "link_text": {
    "color": "#3a94c5",
    "bold": true
  },
  "image": {
    "color": "#df69ba",
    "underline": true
  },
  "image_text": {
    "color": "#a4a9a5",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f85552",
    "background_color": "#f0ebda"
  },
  "code_block": {
    "color": "#5c6a72",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#5c6a72"
      },
      "error": {
        "color": "#fdf6e3",
        "background_color": "#f85552"
      },
      "comment": {
        "color": "#a4a9a5",
        "italic": true
      },
      "comment_preproc": {
        "color": "#dfa000"
      },
      "keyword": {
        "color": "#df69ba"
      },
      "keyword_reserved": {
        "color": "#df69ba"
      },
      "keyword_namespace": {
        "color": "#f85552"
      },
      "keyword_type": {
        "color": "#dfa000"
      },
      "operator": {
        "color": "#35a77c"
      },
      "punctuation": {
        "color": "#5c6a72"
      },
      "name": {
        "color": "#5c6a72"
      },
      "name_builtin": {
        "color": "#f85552"
      },
      "name_tag": {
        "color": "#3a94c5"
      },
      "name_attribute": {
        "color": "#dfa000"
      },
      "name_class": {
        "color": "#dfa000",
        "bold": true
      },
      "name_constant": {
        "color": "#dfa000"
      },
      "name_decorator": {
        "color": "#35a77c"
      },
      "name_exception": {
        "color": "#f85552"
      },
      "name_function": {
        "color": "#3a94c5"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#dfa000"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#8da101"
      },
      "literal_string_escape": {
        "color": "#35a77c"
      },
      "generic_deleted": {
        "color": "#f85552"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#8da101"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#a4a9a5"
      },
      "background": {
        "background_color": "#f0ebda"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
