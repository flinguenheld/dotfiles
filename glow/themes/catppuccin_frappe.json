{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c6d0f5",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#828aa6",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8caaee",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#303446",
    "background_color": "#f4b8e4",
    "bold": true
  },
  "h2": {
    "color": "#8caaee",
    "prefix": "## "
  },
  "h3": {
    "color": "#81c8be",
    "prefix": "### "
  },
  "h4": {
    "color": "#a6d189",
    "prefix": "#### "
  },
  "h5": {
    "color": "#e5c890",
    "prefix": "##### "
  },
  "h6": {
    "color": "#828aa6",
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#e5c890",
    "italic": true
  },
  "strong": {
    "color": "#e78284",
    "bold": true
  },
  "hr": {
    "color": "#828aa6",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#81c8be",
    "underline": true
  },
  "link_text": {
    "color": "#8caaee",
    "bold": true
  },
  "image": {
    "color": "#f4b8e4",
    "underline": true
  },
  "image_text": {
    "color": "#828aa6",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e78284",
    "background_color": "#3c4054"
  },
  "code_block": {
    "color": "#c6d0f5",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#c6d0f5"
      },
      "error": {
        "color": "#303446",
        "background_color": "#e78284"
      },
      "comment": {
        "color": "#828aa6",
        "italic": true
      },
      "comment_preproc": {
        "color": "#e5c890"
      },
      "keyword": {
        "color": "#f4b8e4"
      },
      "keyword_reserved": {
        "color": "#f4b8e4"
      },
      "keyword_namespace": {
        "color": "#e78284"
      },
      "keyword_type": {
        "color": "#e5c890"
      },
      "operator": {
        "color": "#81c8be"
      },
      "punctuation": {
        "color": "#c6d0f5"
      },
      "name": {
        "color": "#c6d0f5"
      },
      "name_builtin": {
        "color": "#e78284"
      },
      "name_tag": {
        "color": "#8caaee"
      },
      "name_attribute": {
        "color": "#e5c890"
      },
      "name_class": {
        "color": "#e5c890",
        "bold": true
      },
      "name_constant": {
        "color": "#e5c890"
      },
      "name_decorator": {
        "color": "#81c8be"
      },
      "name_exception": {
        "color": "#e78284"
      },
      "name_function": {
        "color": "#8caaee"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#e5c890"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#a6d189"
      },
      "literal_string_escape": {
        "color": "#81c8be"
      },
      "generic_deleted": {
        "color": "#e78284"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a6d189"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#828aa6"
      },
      "background": {
        "background_color": "#3c4054"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
