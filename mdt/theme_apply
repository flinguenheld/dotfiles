#!/usr/bin/env bash
# florent@linguenheld.fr 2026

THEME_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$THEME_FOLDER/palette.toml"

MDT_FOLDER="$HOME/.config/mdt"
MDT_FILE="$MDT_FOLDER/config.toml"
MDT_MARK="# GENERATED BY theme_apply"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────── KEEP CONFIG ─────
touch "${MDT_FILE}" || exit 1
MDT_CONFIG_PART=$(sed "/^${MDT_MARK}/,\$d" "${MDT_FILE}") || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# The kept part can be empty (no settings yet): skip it and its blank line
# Headings: h1 is a c0 band, h2..h6 are colored text
# Code: keywords c0, punctuation & operators muted, variables plain
# Help bar & path header share help_bg: off surface, or code blocks merge
{
  if [[ -n "${MDT_CONFIG_PART}" ]]; then
    echo "${MDT_CONFIG_PART}"
    echo
  fi
  echo "${MDT_MARK} from palette.toml (${theme}), do not edit below"
  echo "h_bg_color = \"${c0}\""
  echo "h_fg_color = \"${background}\""
  echo "h2_fg_color = \"${c1}\""
  echo "h3_fg_color = \"${c3}\""
  echo "h4_fg_color = \"${c4}\""
  echo "h5_fg_color = \"${c5}\""
  echo "h6_fg_color = \"${muted}\""
  echo
  echo "code_fg_color = \"${c1}\""
  echo "code_bg_color = \"${surface}\""
  echo "code_block_bg_color = \"${surface}\""
  echo "quote_bg_color = \"${surface}\""
  echo
  echo "link_color = \"${c4}\""
  echo "link_selected_fg_color = \"${background}\""
  echo "link_selected_bg_color = \"${c0}\""
  echo
  echo "table_header_fg_color = \"${c0}\""
  echo "scrollbar_color = \"${muted}\""
  echo "file_tree_selected_fg_color = \"${c0}\""
  echo "file_tree_path_color = \"${muted}\""
  echo "quote_caution = \"${alert}\""
  echo
  echo "help_bg_color = \"${background}\""
  echo "help_fg_color = \"${foreground}\""
  echo "help_title_color = \"${foreground}\""
  echo
  echo "code_hl_keyword = \"${c0}\""
  echo "code_hl_function = \"${c4}\""
  echo "code_hl_function_builtin = \"${c4}\""
  echo "code_hl_type = \"${c6}\""
  echo "code_hl_type_builtin = \"${c6}\""
  echo "code_hl_string = \"${c5}\""
  echo "code_hl_string_special = \"${c6}\""
  echo "code_hl_constant = \"${c1}\""
  echo "code_hl_attribute = \"${c1}\""
  echo "code_hl_property = \"${c3}\""
  echo "code_hl_tag = \"${c3}\""
  echo "code_hl_operator = \"${muted}\""
  echo "code_hl_punctuation = \"${muted}\""
  echo "code_hl_punctuation_bracket = \"${muted}\""
  echo "code_hl_punctuation_delimiter = \"${muted}\""
  echo "code_hl_variable = \"${foreground}\""
  echo "code_hl_variable_builtin = \"${foreground}\""
  echo "code_hl_variable_parameter = \"${foreground}\""
} > "${MDT_FILE}" || exit 1

# No reload: mdt reads its config at startup
