#!/usr/bin/env bash
# florent@linguenheld.fr 2026

THEME_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$THEME_FOLDER/palette.toml"

FUZZEL_FOLDER="$HOME/.config/fuzzel"
FUZZEL_PALETTE_FILE="$FUZZEL_FOLDER/palette.ini"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

if $dark; then
  ALPHA="ee"
else
  ALPHA="dd"
fi

# ──────────                                      ─────────────────────────────
# ─────                                     ────────────────────── FORMAT ─────
# fuzzel wants RRGGBBAA without the #: ${color#\#} removes the leading #,
# then the alpha is added (ff = opaque, ee = slightly transparent)
rgba() {
  echo "${1#\#}${2:-ff}"
}


# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# The plain text stays foreground: a random accent on the background could
# be hard to read.
{
  echo "# Generated by theme_apply from palette.toml (${theme}), do not edit"
  echo "[colors]"
  echo "background=$(rgba "${background}" "${ALPHA}")"
  echo "text=$(rgba "${foreground}")"
  echo "prompt=$(rgba "${c4}")"
  echo "placeholder=$(rgba "${muted}")"
  echo "input=$(rgba "${c4}")"
  echo "match=$(rgba "${c4}")"
  echo "selection=$(rgba "${c0}")"
  echo "selection-text=$(rgba "${background}")"
  echo "selection-match=$(rgba "${surface}")"
  echo "counter=$(rgba "${muted}")"
  echo "border=$(rgba "${c0}")"
} > "${FUZZEL_PALETTE_FILE}" || exit 1

# No reload: fuzzel reads its config each time it opens
