#!/usr/bin/env bash
# florent@linguenheld.fr 2026

PALETTE_FILE="$HOME/.config/theme/palette.toml"

# GTK keeps this setting in dconf, not in a file of this folder: the folder
# only holds this adapter (and GTK's own files if it ever writes some)
GTK_SCHEMA="org.gnome.desktop.interface"
GTK_KEY="color-scheme"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $dark $background ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# Light or dark for the GTK apps (through the portal): no reload needed
if $dark; then
  gsettings set "${GTK_SCHEMA}" "${GTK_KEY}" "prefer-dark"
else
  gsettings set "${GTK_SCHEMA}" "${GTK_KEY}" "prefer-light"
fi
