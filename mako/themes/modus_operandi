## Mako configuration file

# GLOBAL CONFIGURATION OPTIONS
max-history=100
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# STYLE OPTIONS
font=JetBrains Mono 12
width=400
height=700
margin=20
padding=15
border-size=4
border-radius=12
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=left
default-timeout=7000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

# Mako_Colors
border-color=#fbf7f0
text-color=#fbf7f0
background-color=#005e8b
# progress-color=over #fbf7f0

[urgency=low]
background-color=#006800
default-timeout=5000

[urgency=normal]
background-color=#0031a9
default-timeout=5000

[urgency=high]
background-color=#a60000
default-timeout=0
