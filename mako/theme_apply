#!/usr/bin/env bash
# florent@linguenheld.fr 2026

THEME_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$THEME_FOLDER/palette.toml"

MAKO_FOLDER="$HOME/.config/mako"
MAKO_PALETTE_FILE="$MAKO_FOLDER/palette"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# Every notification has one of the 3 urgencies, so each section holds all
# its colors: the file has no global part (config includes it at the end).
{
  echo "# Generated by theme_apply from palette.toml (${theme}), do not edit"
  echo
  echo "[urgency=low]"
  echo "border-color=${background}"
  echo "text-color=${background}"
  echo "background-color=${c2}"
  echo
  echo "[urgency=normal]"
  echo "border-color=${background}"
  echo "text-color=${background}"
  echo "background-color=${c4}"
  echo
  echo "[urgency=high]"
  echo "border-color=${background}"
  echo "text-color=${background}"
  echo "background-color=${alert}"
} > "${MAKO_PALETTE_FILE}" || exit 1

makoctl reload
