#!/usr/bin/env bash
# florent@linguenheld.fr 2026

THEME_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$THEME_FOLDER/palette.toml"

STARSHIP_FOLDER="$HOME/.config/starship"
STARSHIP_FILE="$STARSHIP_FOLDER/starship.toml"
STARSHIP_REG="^palette = \".*\""
STARSHIP_MARK="# GENERATED BY theme_apply"

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ... $c0 ... $c6
source "${PALETTE_FILE}" || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────── KEEP CONFIG ─────
STARSHIP_CONFIG_PART=$(sed -e "/^${STARSHIP_MARK}/,\$d" \
                           -e "s%${STARSHIP_REG}%palette = \"generated\"%" \
                           "${STARSHIP_FILE}") || exit 1

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# The ip block only shows over ssh
{
  echo "${STARSHIP_CONFIG_PART}"
  echo
  echo "${STARSHIP_MARK} from palette.toml (${theme}), do not edit below"
  echo "[palettes.generated]"
  echo "bg_user = \"${c0}\""
  echo "bg_ip = \"${c6}\""
  echo "bg_git = \"${c1}\""
  echo "bg_dir = \"${c2}\""
  echo "bg_code = \"${surface}\""
  echo "bg_status = \"${surface}\""
  echo "bg_transparent = \"#FF000000\""
  echo
  echo "fg_user = \"${background}\""
  echo "fg_ip = \"${background}\""
  echo "fg_git = \"${background}\""
  echo "fg_dir = \"${background}\""
  echo "fg_rust = \"${alert}\""
  echo "fg_c = \"${c4}\""
  echo "fg_lua = \"${c4}\""
  echo "fg_python = \"${c1}\""
  echo "fg_duration = \"${c1}\""
  echo "fg_status = \"${alert}\""
  echo "fg_job = \"${c5}\""
} > "${STARSHIP_FILE}" || exit 1

# No reload: starship reads its config at every prompt
