#!/usr/bin/env bash
# florent@linguenheld.fr 2024

# Next to this script, even if the folder moves
WORDS_FILE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/pipe_words.txt"
MAX_LENGTH=20   # longer selections are not words, give them back unchanged

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── USAGE ─────
usage() {
  echo "Usage: $(basename "${0}") [option] < word"
  echo "   Look for the piped word in $WORDS_FILE"
  echo "   and print the next one of its line, with the same case."
  echo "   Anything else (unknown word, several lines…) is printed unchanged."
  echo
  echo "Options:"
  echo "   --previous, -p   print the previous word instead"
  echo "   --list, -l       print the word lines"
  echo "   --help, -h       print this help"
}

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────── ARGUMENTS ─────
MODE="next"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --previous | -p)
      MODE="previous"
    ;;
    --list | -l)
      MODE="list"
    ;;
    --help | -h)
      usage
      exit 0
    ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
    ;;
  esac
  shift
done

# ──────────                                      ─────────────────────────────
# ─────                                     ──────────────────────── LIST ─────
if [[ $MODE == "list" ]]; then
  grep -v -e '^//' -e '^$' "$WORDS_FILE" | sed 's/,/, /g'
  exit 0
fi

# ──────────                                      ─────────────────────────────
# ─────                                     ────────────── READ SELECTION ─────
# Helix replaces the whole selection with the output, so every byte counts:
# $(...) drops the trailing newlines, the "x" guard keeps them
INPUT=$(cat; printf x)
INPUT=${INPUT%x}

# Several lines or a long text: give it back untouched
if [[ $INPUT == *$'\n'?* || ${#INPUT} -gt $MAX_LENGTH ]]; then
  printf '%s' "$INPUT"
  exit 0
fi

# Split around the word, so "true " (helix `w`) keeps its space
# BASH_REMATCH[1]: leading spaces, [2]: the word, [3]: trailing spaces
if [[ ! $INPUT =~ ^([[:space:]]*)(.*[^[:space:]])([[:space:]]*)$ ]]; then
  printf '%s' "$INPUT"   # only spaces
  exit 0
fi
BEFORE="${BASH_REMATCH[1]}"
PIPED="${BASH_REMATCH[2]}"
AFTER="${BASH_REMATCH[3]}"

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────── FIND WORD ─────
# A line is a loop: its last word repeats the first one, so
#   next     : look from the start, take the word after
#   previous : look from the end,   take the word before
FOUND=""

while IFS= read -r LINE; do
  [[ -z $LINE || $LINE == //* ]] && continue

  # IFS=',' only: "let mut" stays one word
  IFS=',' read -r -a WORDS <<< "$LINE"
  LAST=$(( ${#WORDS[@]} - 1 ))

  if [[ $MODE == "previous" ]]; then
    for (( i = LAST; i > 0; i-- )); do
      if [[ "${PIPED,,}" == "${WORDS[$i]}" ]]; then
        FOUND="${WORDS[$((i - 1))]}"
        break 2
      fi
    done
  else
    for (( i = 0; i < LAST; i++ )); do
      if [[ "${PIPED,,}" == "${WORDS[$i]}" ]]; then
        FOUND="${WORDS[$((i + 1))]}"
        break 2
      fi
    done
  fi
done < "$WORDS_FILE"

# ──────────                                      ─────────────────────────────
# ─────                                     ────────────────────── OUTPUT ─────
if [[ -z $FOUND ]]; then
  printf '%s' "$INPUT"
  exit 0
fi

# Same case as the piped word: TRUE → FALSE, True → False, true → false
case "$PIPED" in
  "${PIPED^^}")
    FOUND="${FOUND^^}"
  ;;
  "${PIPED^}")
    FOUND="${FOUND^}"
  ;;
esac

# printf, not echo: echo would eat a word like "-n"
printf '%s' "${BEFORE}${FOUND}${AFTER}"
