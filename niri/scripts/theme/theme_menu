#!/usr/bin/env bash
# florent@linguenheld.fr 2025

NIRI_FOLDER="$HOME/.config/niri"

# Colors: theme_make_palette writes palette.toml, then each program's
# theme_apply reads it and writes its own file
THEME_FOLDER="$NIRI_FOLDER/scripts/theme"
THEME_ADAPTERS=(
  "$NIRI_FOLDER/theme_apply"
  "$HOME/.config/waybar/theme_apply"
  "$HOME/.config/mako/theme_apply"
  "$HOME/.config/fuzzel/theme_apply"
  "$HOME/.config/starship/theme_apply"
  "$HOME/.config/gtk-3.0/theme_apply"
)

# Programs with their own built-in themes: only the theme name changes
GLOW_FILE="$HOME/.config/glow/glow.yml"
GLOW_REG="^style: \".*\""

HELIX_FILE="$HOME/.config/helix/config.toml"
HELIX_REG="theme = \".*\""

WEZTERM_FILE="$HOME/.wezterm.lua"
WEZTERM_REG="config\.color_scheme = '.*'"

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── USAGE ─────
usage() {
  echo "Usage: $(basename "${0}")"
  echo "   Pick a theme in two fuzzel menus, then apply it to every program."
  echo "   The accent colors are shuffled each time."
  echo
  echo "Options:"
  echo "   --help, -h   print this help"
}

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────── ARGUMENTS ─────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help | -h)
      usage
      exit 0
    ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
    ;;
  esac
  shift
done

# ──────────                                      ─────────────────────────────
# ─────                                     ──────────────────────── MENU ─────
case $(echo -e "Ayu\nCatppuccin\nEverforest\nGruvbox" | fuzzel --dmenu \
                                                          --font "JetBrains Mono:size=25" \
                                                          --lines 4 \
                                                          --width 30 \
                                                          --line-height 50 \
                                                          --inner-pad 50 \
                                                          --placeholder " Theme selection") in
  "Ayu")
    CHOICE="Ayu Light\nAyu Mirage\n"
  ;;
  "Catppuccin")
    CHOICE="Latte\nFrappe\nMacchiato\nMocha\n"
  ;;
  "Everforest")
    CHOICE="Everforest Light\nEverforest Dark\n"
  ;;
  "Gruvbox")
    CHOICE="Gruv Light\nGruv Dark\n"
  ;;
  *)
    exit 0
  ;;
esac

# ──────────                                      ─────────────────────────────
# ─────                                     ──────────────────── FLAVOURS ─────
case $(echo -e "${CHOICE}  󱞦" | fuzzel --dmenu \
                                       --font "JetBrains Mono:size=25" \
                                       --lines "$(echo -e "$CHOICE" | wc -l)" \
                                       --width 30 \
                                       --line-height 50 \
                                       --inner-pad 50 \
                                       --placeholder " Flavour") in

  "Frappe")
    THEME="catppuccin_frappe"
    THEME_HX="catppuccin_frappe"
    THEME_WZ="Catppuccin Frappe"
  ;;
  "Latte")
    THEME="catppuccin_latte"
    THEME_HX="catppuccin_latte"
    THEME_WZ="Catppuccin Latte"
  ;;
  "Macchiato")
    THEME="catppuccin_macchiato"
    THEME_HX="catppuccin_macchiato"
    THEME_WZ="Catppuccin Macchiato"
  ;;
  "Mocha")
    THEME="catppuccin_mocha"
    THEME_HX="catppuccin_mocha"
    THEME_WZ="Catppuccin Mocha"
  ;;
  "Gruv Dark")
    THEME="gruvbox"
    THEME_HX="gruvbox"
    THEME_WZ="Gruvbox Dark (Gogh)"
  ;;
  "Gruv Light")
    THEME="gruvbox_light"
    THEME_HX="gruvbox_light"
    THEME_WZ="Gruvbox (Gogh)"
  ;;
  "Ayu Mirage")
    THEME="ayu_mirage"
    THEME_HX="ayu_mirage"
    THEME_WZ="Ayu Mirage"
  ;;
  "Ayu Light")
    THEME="ayu_light"
    THEME_HX="ayu_light"
    THEME_WZ="ayu_light"
  ;;
  "Everforest Dark")
    THEME="everforest_dark"
    THEME_HX="everforest_dark"
    THEME_WZ="Everforest Dark (Gogh)"
  ;;
  "Everforest Light")
    THEME="everforest_light"
    THEME_HX="everforest_light"
    THEME_WZ="Everforest Light (Gogh)"
  ;;
  "  󱞦")
    # exec: this script is replaced, not left waiting behind the new one
    exec "$0"
  ;;
  *)
    exit 0
  ;;
esac

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
# The flavour case above sets THEME, or leaves (exit, exec): THEME is set here
# Colors: the palette (accents shuffled), then every adapter
"${THEME_FOLDER}/theme_make_palette" "${THEME}" > /dev/null || exit 1
for adapter in "${THEME_ADAPTERS[@]}"; do
  "${adapter}"
done

# Built-in themes
sed -i "s#${WEZTERM_REG}#config.color_scheme = '${THEME_WZ}'#" "${WEZTERM_FILE}"
sed -i "s#${GLOW_REG}#style: \"${HOME}/.config/glow/themes/${THEME}.json\"#" "${GLOW_FILE}"
sed -i "s#${HELIX_REG}#theme = \"${THEME_HX}\"#" "${HELIX_FILE}" && pkill -USR1 hx 2> /dev/null

# Restart swaybg, swayidle and waybar: they read the new palette
"${NIRI_FOLDER}/scripts/startup" &
