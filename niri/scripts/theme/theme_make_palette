#!/usr/bin/env bash
# florent@linguenheld.fr 2026

PALETTE_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$PALETTE_FOLDER/palette.toml"
FIXED_NAMES=("background" "foreground" "surface" "muted" "alert")

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── USAGE ─────
usage() {
  echo "Usage: $(basename "${0}") [--original] theme_name"
  echo "   Generate or overwrite $PALETTE_FILE"
  echo "   with the colors of the given theme, in a random order."
  echo
  echo "Options:"
  echo "   --original   keep the theme's order instead of shuffling"
  echo "   --help, -h   print this help"
  echo
  echo "Theme names:"
  # The script reads its own case: every line like  "name")
  # ${BASH_SOURCE[0]}: this file's path, right even if it's sourced
  grep -oE '^[[:space:]]*"[a-z_]+"\)' "${BASH_SOURCE[0]}" \
    | awk -F'"' '{ print "   " $2 }'
}

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────── ARGUMENTS ─────
ORIGINAL=false
THEME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --original)
      ORIGINAL=true
    ;;
    --help | -h)
      usage
      exit 0
    ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
    ;;
    *)
      THEME="$1"
    ;;
  esac
  shift
done

# ──────────                                      ─────────────────────────────
# ─────                                     ──────────────── SELECT THEME ─────
# DARK   : true for a dark background (lets the adapters adjust)
# FIXED  : background foreground surface muted alert
# COLORS : 7 accents, original order: c0 orange, c1 yellow, c2 green, c3 cyan,
#          c4 blue, c5 purple, c6 pink (≈, see the 7th color notes)
case "$THEME" in
  "catppuccin_frappe")
    DARK=true
    FIXED=("#303446" "#c6d0f5" "#414559" "#737994" "#e78284")
    COLORS=("#ef9f76" "#e5c890" "#a6d189" "#81c8be" "#8caaee" "#ca9ee6" "#f4b8e4")
  ;;
  "catppuccin_latte")
    DARK=false
    FIXED=("#eff1f5" "#4c4f69" "#ccd0da" "#9ca0b0" "#d20f39")
    COLORS=("#fe640b" "#df8e1d" "#40a02b" "#179299" "#1e66f5" "#8839ef" "#ea76cb")
  ;;
  "catppuccin_macchiato")
    DARK=true
    FIXED=("#24273a" "#cad3f5" "#363a4f" "#6e738d" "#ed8796")
    COLORS=("#f5a97f" "#eed49f" "#a6da95" "#8bd5ca" "#8aadf4" "#c6a0f6" "#f5bde6")
  ;;
  "catppuccin_mocha")
    DARK=true
    FIXED=("#1e1e2e" "#cdd6f4" "#313244" "#6c7086" "#f38ba8")
    COLORS=("#fab387" "#f9e2af" "#a6e3a1" "#94e2d5" "#89b4fa" "#cba6f7" "#f5c2e7")
  ;;
  "gruvbox")
    DARK=true
    FIXED=("#282828" "#ebdbb2" "#3c3836" "#928374" "#fb4934")
    COLORS=("#fe8019" "#fabd2f" "#b8bb26" "#8ec07c" "#83a598" "#d3869b" "#d5c4a1")  # 7th: beige (fg2)
  ;;
  "gruvbox_light")
    DARK=false
    FIXED=("#fbf1c7" "#3c3836" "#ebdbb2" "#928374" "#9d0006")
    COLORS=("#af3a03" "#b57614" "#79740e" "#427b58" "#076678" "#8f3f71" "#458588")  # 7th: neutral blue
  ;;
  "ayu_mirage")
    DARK=true
    FIXED=("#1f2430" "#cbccc6" "#191e2a" "#707a8c" "#f28779")
    COLORS=("#ffa759" "#ffd580" "#bae67e" "#95e6cb" "#73d0ff" "#d4bfff" "#f29e74")  # 7th: operator orange
  ;;
  "ayu_light")
    DARK=false
    FIXED=("#fafafa" "#5c6773" "#f0eee4" "#abb0b6" "#ff3333")
    COLORS=("#fa8d3e" "#f2ae49" "#86b300" "#4cbf99" "#399ee6" "#a37acc" "#f07178")  # 7th: markup pink
  ;;
  "modus_vivendi")
    DARK=true
    FIXED=("#0d0e1c" "#ffffff" "#1d2235" "#989898" "#ff5f59")
    COLORS=("#dfaf7a" "#d0bc00" "#44bc44" "#00d3d0" "#2fafff" "#b6a0ff" "#feacd0")
  ;;
  "modus_operandi")
    DARK=false
    FIXED=("#fbf7f0" "#000000" "#efe9dd" "#595959" "#a60000")
    COLORS=("#7a4f2f" "#6f5500" "#006800" "#005e8b" "#0031a9" "#531ab6" "#721045")
  ;;
  "")
    echo "No theme given" >&2
    usage >&2
    exit 1
  ;;
  *)
    echo "Unknown theme: $THEME (see --help)" >&2
    exit 1
  ;;
esac

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────── CREATE TOML ─────
mkdir -p "$PALETTE_FOLDER"
if $ORIGINAL; then
  ACCENTS=("${COLORS[@]}")
else
  ACCENTS=($(shuf -e "${COLORS[@]}"))
fi

{
  echo "# Generated by $(basename "${0}"), $(date --utc "+%Y-%m-%d %H:%M"), do not edit"
  echo "theme=\"$THEME\""
  echo "dark=${DARK}"
  echo
  for i in "${!FIXED_NAMES[@]}"; do
    echo "${FIXED_NAMES[$i]}=\"${FIXED[$i]}\""
  done
  echo
  for i in "${!ACCENTS[@]}"; do
    echo "c$i=\"${ACCENTS[$i]}\""
  done
} > "$PALETTE_FILE" || exit 1   # can't write (permissions, full disk…)

# ──────────                                      ─────────────────────────────
# ─────                                     ──────────────────────── DONE ─────
echo "$THEME palette generated in $PALETTE_FILE"
