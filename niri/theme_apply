#!/usr/bin/env bash
# florent@linguenheld.fr 2026

THEME_FOLDER="$HOME/.config/theme"
PALETTE_FILE="$THEME_FOLDER/palette.toml"
MIX_COLOR="$THEME_FOLDER/theme_mix_color"

NIRI_FOLDER="$HOME/.config/niri"
NIRI_STYLE_FILE="$NIRI_FOLDER/config/style.kdl"
NIRI_REG_ACTIVE=" active-gradient .*"
NIRI_REG_INACTIVE=" inactive-gradient .*"

MIX_PERCENT=35   # % of the second color at the end of the gradient

# ──────────                                      ─────────────────────────────
# ─────                                     ───────────────────── PALETTE ─────
# Get the palette variables $background $foreground ...
source "${PALETTE_FILE}" || exit 1

NEW_NIRI_ACTIVE=" active-gradient from=\"${c0}\" to=\"$("${MIX_COLOR}" "${c0}" "${background}" "${MIX_PERCENT}")\""
NEW_NIRI_INACTIVE=" inactive-gradient from=\"${muted}\" to=\"$("${MIX_COLOR}" "${muted}" "${foreground}" "${MIX_PERCENT}")\""

# ──────────                                      ─────────────────────────────
# ─────                                     ─────────────────────── APPLY ─────
sed -i "s%${NIRI_REG_ACTIVE}%${NEW_NIRI_ACTIVE}%" "${NIRI_STYLE_FILE}"
sed -i "s%${NIRI_REG_INACTIVE}%${NEW_NIRI_INACTIVE}%" "${NIRI_STYLE_FILE}"

# Rebuild config.kdl from config/*.kdl: niri reloads it by itself
"${NIRI_FOLDER}/scripts/combine_niri_config"
